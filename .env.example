# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_WEBHOOK_SECRET=random-long-string
GROUP_CHAT_ID=-1001234567890

# Vercel Cron (sent as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=random-long-string

# Neon: pooled URL for runtime, direct URL for migrations
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Scheduling (group-local time)
GROUP_TIMEZONE=Europe/London
REMINDER_CUTOFF=21:30
REPORT_TIME=22:00
